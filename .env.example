# ============================================================================
# Reelhouse — Melbourne, Sydney & Shanghai Cinema & Ratings API Configuration
# Copy to `.env` locally (`cp .env.example .env`) or enter these keys in your
# Render / Railway / Fly.io / Cloud Run Environment Variables dashboard.
# Keys stay strictly server-side and are never exposed in browser bundles.
# ============================================================================

# 1. TMDB API Key (v3 auth — 32-char hex string, 100% Free)
# Get it at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# 2. OMDb API Key (Free tier: 1,000 requests/day — live IMDb & Rotten Tomatoes)
# Get it at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# 3. MDBList API Key (Free tier: 1,000 requests/day — live Rotten Tomatoes Critics & Audience)
# Get it at: https://mdblist.com/preferences/
MDBLIST_API_KEY=

# 4. SerpApi Key (Free plan: 250 searches/month — live Melbourne & Sydney Google Showtimes)
# Note: Shanghai (Maoyan), IMAX Melbourne, and Golden Age Sydney scrape directly at 0 quota cost.
# Get it at: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Optional cache tuning (default 24h in production containers to preserve free quotas):
CACHE_TTL_HOURS=24
RATINGS_TTL_HOURS=24
BFF_PORT=3100

# 5. Firebase Web Client Config (Free Spark Plan — Email/Password + Google Sign-In & Firestore Sync)
# Public client identifiers (data access is enforced by Firestore Security Rules).
# Set these in `.env` locally and in Render Environment Variables for production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
